# Server-side only. Never expose these through VITE_ variables.
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://litellm.vision.aivar.app/v1
OPENAI_API_KEY=
MODEL=claude-sonnet-4.6
NEATLOGS_API_KEY=
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174
CONTROL_BASE_URL=http://localhost:4174
RUNNER_PORT=3001
# BUGREPLAY_ENV_FILE=/absolute/path/to/private.env
# ARTIFACT_ROOT=artifacts
# NEATLOGS_ENDPOINT= (override only with the provider's confirmed endpoint)
# Existing LLM_BASE_URL, LLM_API_KEY and LLM_MODEL names remain supported.
# Nonblank LLM_* values override the corresponding organizer aliases above.
# Bedrock is prohibited by the hackathon rules; use the supplied LiteLLM gateway.
# Defaults: 40 actions, 40 calls, 4 hypotheses, 360000ms investigation,
# 120000ms verification, 480000ms total.
